# ============================================================================
# Stock Analyzer Pro - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your API keys
# NEVER commit the .env file with real credentials!
# ============================================================================

# ==== AI ASSISTANT ====
# Mistral AI API (for cloud mode)
# Get your key at: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-small-latest

# Ollama (for local mode)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# ==== ESG DATA SOURCES ====
# Finnhub API (optional - for additional ESG data)
# Get your key at: https://finnhub.io/
FINNHUB_API_KEY=

# Financial Modeling Prep API (optional - for ESG history)
# Get your key at: https://financialmodelingprep.com/
FMP_API_KEY=

# NewsAPI (optional - for ESG news sentiment)
# Get your key at: https://newsapi.org/
NEWSAPI_KEY=

# ==== MARKET DATA ====
# Alpha Vantage (optional - for additional market data)
# Get your key at: https://www.alphavantage.co/
ALPHA_VANTAGE_KEY=

# ==== APPLICATION SETTINGS ====
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==== NOTES ====
# - yfinance (Yahoo Finance) doesn't require an API key
# - Most features work without any API keys configured
# - Add keys progressively based on features you need
